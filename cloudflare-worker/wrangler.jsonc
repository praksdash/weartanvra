{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"weartanvra-payments",
  "main":"src/index.js",
  "compatibility_date":"2026-09-01",
  "vars":{
    "ALLOWED_ORIGINS":"https://weartanvra.com,https://www.weartanvra.com",
    "PREPAID_DISCOUNT":"50","FREE_SHIPPING_ABOVE": "799",
    "PREPAID_SHIPPING_BELOW_THRESHOLD": "68","COD_MINIMUM_BELOW_THRESHOLD": "98","COD_PERCENT_BELOW_THRESHOLD": "2.3"
  },
  "d1_databases":[{"binding":"DB","database_name":"weartanvra-orders","database_id":"REPLACE_WITH_D1_DATABASE_ID"}]
}
